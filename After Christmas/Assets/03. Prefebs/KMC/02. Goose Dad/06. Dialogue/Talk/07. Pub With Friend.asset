%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1c24672a27f90a24fb333e3077219294, type: 3}
  m_Name: 07. Pub With Friend
  m_EditorClassIdentifier: 
  dialogueID: 0
  prerequisiteCondition: {fileID: 0}
  failSafeDialogue: {fileID: 11400000}
  participants:
  - {fileID: 11400000, guid: 9ab2da8d8a102d544b3cd1b4f3e4b2c4, type: 2}
  - {fileID: 11400000, guid: fd0830ce7cb70644a8969dc5c6ca986f, type: 2}
  dialogueLines:
  - speaker: {fileID: 11400000, guid: fd0830ce7cb70644a8969dc5c6ca986f, type: 2}
    sentence: "\uC678\uB85C\uC6CC\uC11C \uC5B4\uB5A1\uD558\uB0D0? \uAC00\uC871\uC774\uBA74
      \uC8FD\uACE0 \uBABB \uC0B4\uB358 \uB188\uC774."
  - speaker: {fileID: 11400000, guid: 9ab2da8d8a102d544b3cd1b4f3e4b2c4, type: 2}
    sentence: "\uC678\uB86D\uAE34 \uBB58. \uB0B4\uAC00 \uC560\uB0D0?"
  - speaker: {fileID: 11400000, guid: fd0830ce7cb70644a8969dc5c6ca986f, type: 2}
    sentence: "\uC55E\uC73C\uB85C \uC220 \uB9C8\uC2DC\uC790\uD558\uBA74 \uBC14\uB85C\uBC14\uB85C
      \uB098\uC640. \uC194\uC9C1\uD788 \uB108 \uC81C\uC218\uC528 \uB9CC\uB098\uACE0
      \uB098\uB791 \uC548 \uB180\uC544\uC92C\uC796\uC544."
  - speaker: {fileID: 11400000, guid: 9ab2da8d8a102d544b3cd1b4f3e4b2c4, type: 2}
    sentence: "\uBB54 \uC18C\uB9AC\uC57C. \uB0B4\uAC00 \uC5B8\uC81C \uADF8\uB7AC\uB2E4\uACE0."
  - speaker: {fileID: 11400000, guid: 9ab2da8d8a102d544b3cd1b4f3e4b2c4, type: 2}
    sentence: "...\uADF8\uB7AC\uB098?"
  - speaker: {fileID: 11400000, guid: fd0830ce7cb70644a8969dc5c6ca986f, type: 2}
    sentence: "\uB0B4\uAC00 \uB108 \uB300\uD559 \uB54C\uBD80\uD130 \uBD10\uC654\uB294\uB370,
      \uBB50\uB9CC \uD558\uBA74 \uC81C\uC218\uC528 \uBCF4\uB7EC \uAC04\uB2E4\uACE0
      \uB098 \uBC84\uB9AC\uACE0 \uAC14\uC796\uB0D0."
  - speaker: {fileID: 11400000, guid: fd0830ce7cb70644a8969dc5c6ca986f, type: 2}
    sentence: "\uC218\uC5C5 \uB05D\uB098\uBA74 \uB6F0\uCCD0\uB098\uAC00\uACE0, \uC220
      \uB9C8\uC2DC\uC790\uD558\uBA74 \uB370\uC774\uD2B8\uD558\uAC70\uB098 \uC54C\uBC14\uD558\uAC70\uB098.
      \uC54C\uBC14\uB3C4 \uB370\uC774\uD2B8\uBE44 \uBC8C\uB824\uACE0 \uD588\uC5C8\uC9C0?"
  - speaker: {fileID: 11400000, guid: fd0830ce7cb70644a8969dc5c6ca986f, type: 2}
    sentence: "\uC6B0\uC815\uBCF4\uB2E4 \uC0AC\uB791\uC774\uB2E4 \uC774\uAC70\uC9C0.
      \uC11C\uC6B4\uD558\uB2E4 \uC11C\uC6B4\uD574~."
  - speaker: {fileID: 11400000, guid: fd0830ce7cb70644a8969dc5c6ca986f, type: 2}
    sentence: "\uC544, \uBBF8\uC548\uD574, \uC778\uB9C8. \uC55E\uC73C\uB85C \uC790\uC8FC
      \uBCF4\uBA74 \uB418\uC9C0 \uBB50."
  - speaker: {fileID: 11400000, guid: fd0830ce7cb70644a8969dc5c6ca986f, type: 2}
    sentence: "\uADF8\uB798\uADF8\uB798. \uB3C8\uB3C4 \uB9CE\uC73C\uB2C8\uAE4C \uC55E\uC73C\uB860
      \uB124\uAC00 \uC880 \uC0AC\uB77C. \uB098 \uB3C8 \uC5C6\uC5B4."
  - speaker: {fileID: 11400000, guid: fd0830ce7cb70644a8969dc5c6ca986f, type: 2}
    sentence: "\uBB50? \uC57C, \uB098\uB3C4 \uB3C8 \uC5C6\uC5B4."
  - speaker: {fileID: 11400000, guid: fd0830ce7cb70644a8969dc5c6ca986f, type: 2}
    sentence: "\uB108 \uB3D9\uCC3D\uD68C \uB54C \uAE30\uC5B5 \uC548 \uB098\uB0D0?
      \uC18C\uC8FC\uBCD1 \uC9D1\uC5B4\uB4E4\uACE0 \uC329 \uB09C\uB9AC\uCE60 \uB54C
      \uB9C9\uC544\uC900 \uAC8C \uB204\uAD6C\uC9C0?"
  - speaker: {fileID: 11400000, guid: fd0830ce7cb70644a8969dc5c6ca986f, type: 2}
    sentence: "...\uC774\uAC74 \uC0AC\uC904\uAC8C."
