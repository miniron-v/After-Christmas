  m_Name: 06. Night Work
  m_EditorClassIdentifier: 
  dialogueID: 0
  prerequisiteCondition: {fileID: 0}
  failSafeDialogue: {fileID: 11400000}
  participants:
  - {fileID: 11400000, guid: 9ab2da8d8a102d544b3cd1b4f3e4b2c4, type: 2}
  - {fileID: 11400000, guid: 987e42df4611eff46ac4e3e4b8260897, type: 2}
  dialogueLines:
  - speaker: {fileID: 11400000, guid: 987e42df4611eff46ac4e3e4b8260897, type: 2}
    sentence: "\uCC28\uC7A5\uB2D8, \uB610 \uC57C\uADFC\uC778\uAC00\uC694? \uB108\uBB34
      \uC790\uC8FC\uD558\uC2DC\uBA74 \uBAB8 \uC0C1\uD574\uC694."
  - speaker: {fileID: 11400000, guid: 9ab2da8d8a102d544b3cd1b4f3e4b2c4, type: 2}
    sentence: "\uC2EC\uC2EC\uD574\uC11C \uADF8\uB798. \uC9D1\uC5D0 \uAC00\uBD10\uC57C
      \uC544\uBB34\uB3C4 \uC5C6\uB294\uB370 \uBB58. \uB208\uCE58\uBCF4\uC9C0 \uB9D0\uACE0
      \uBA3C\uC800 \uD1F4\uADFC\uD574."
  - speaker: {fileID: 11400000, guid: 987e42df4611eff46ac4e3e4b8260897, type: 2}
    sentence: "\uADF8\uB7FC \uBA3C\uC800 \uB4E4\uC5B4\uAC00\uBCF4\uACA0\uC2B5\uB2C8\uB2E4."
  - speaker: {fileID: 11400000, guid: 987e42df4611eff46ac4e3e4b8260897, type: 2}
    sentence: "...\uB108\uBB34 \uBB34\uB9AC\uD558\uC9C4 \uB9C8\uC138\uC694."
