--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1c24672a27f90a24fb333e3077219294, type: 3}
  m_Name: 35. Big Event
  m_EditorClassIdentifier: 
  dialogueID: 0
  prerequisiteCondition: {fileID: 0}
  failSafeDialogue: {fileID: 11400000}
  participants:
  - {fileID: 11400000, guid: 9ab2da8d8a102d544b3cd1b4f3e4b2c4, type: 2}
  - {fileID: 11400000, guid: fd0830ce7cb70644a8969dc5c6ca986f, type: 2}
  dialogueLines:
  - speaker: {fileID: 11400000, guid: fd0830ce7cb70644a8969dc5c6ca986f, type: 2}
    sentence: "\uD5C9, \uD5C9...."
  - speaker: {fileID: 11400000, guid: 9ab2da8d8a102d544b3cd1b4f3e4b2c4, type: 2}
    sentence: "\uC57C, \uBE68\uB9AC \uC640!"
  - speaker: {fileID: 11400000, guid: fd0830ce7cb70644a8969dc5c6ca986f, type: 2}
    sentence: "\uBB50?! \uC57C, \uADF8\uB7F4 \uAC70\uBA74 \uB2C8\uAC00 \uB4E4\uB358\uAC00!
      \uC774\uAC8C \uC5BC\uB9C8\uB098 \uBB34\uAC70\uC6B4\uB370!"
  - speaker: {fileID: 11400000, guid: fd0830ce7cb70644a8969dc5c6ca986f, type: 2}
    sentence: "\uD6C4.... \uC774\uBC88\uC5D4 \uCEE4\uB2E4\uB780 \uACF0\uB3CC\uC774\uB0D0?
      \uBB54\uB188\uC758 \uC774\uBCA4\uD2B8\uB97C \uADF8\uB9AC \uB9CE\uC774 \uD574?"
  - speaker: {fileID: 11400000, guid: fd0830ce7cb70644a8969dc5c6ca986f, type: 2}
    sentence: "\uC194\uC9C1\uD788 \uB9D0\uD574 \uBD10. \uB108 \uC54C\uBC14\uB85C
      \uBC88 \uB3C8 \uB370\uC774\uD2B8\uC5D0 \uB2E4 \uC4F0\uC9C0?"
  - speaker: {fileID: 11400000, guid: 9ab2da8d8a102d544b3cd1b4f3e4b2c4, type: 2}
    sentence: "\uB2C8\uAC00 \uC5F0\uC560\uB97C \uBABB \uD574\uBD10\uC11C \uADF8\uB798.
      \uC5F0\uC560\uD558\uBA74 \uC774 \uC815\uB3C8 \uAE30\uBCF8\uC774\uC57C."
  - speaker: {fileID: 11400000, guid: 9ab2da8d8a102d544b3cd1b4f3e4b2c4, type: 2}
    sentence: "\uC774\uAC8C \uB610 \uAE30\uB9CC\uD558\uB124. \uC57C, \uB300\uCCB4
      \uAC54\uAC00 \uC5BC\uB9C8\uB098 \uC88B\uC544\uC11C \uADF8\uB7EC\uB0D0?"
  - speaker: {fileID: 11400000, guid: 9ab2da8d8a102d544b3cd1b4f3e4b2c4, type: 2}
    sentence: "\uB0B4\uAC00 \uB2C8 \uC774\uBCA4\uD2B8 \uB3C4\uC640\uC900 \uAC8C \uD55C\uB450\uBC88\uC774
      \uC544\uB2CC\uB370, \uB09C \uAC54\uAC00 \uB108\uD55C\uD14C \uACE0\uB9D9\uB2E4\uD558\uB294
      \uAC74 \uD55C\uBC88\uB3C4 \uBABB \uBCF8 \uAC83 \uAC19\uB2E4."
  - speaker: {fileID: 11400000, guid: 9ab2da8d8a102d544b3cd1b4f3e4b2c4, type: 2}
    sentence: "\uC6D0\uB798 \uADF8\uB798. \uC9C1\uC811 \uD45C\uD604\uD558\uB294 \uC2A4\uD0C0\uC77C\uC740
      \uC544\uB2C8\uB77C\uC11C."
  - speaker: {fileID: 11400000, guid: 9ab2da8d8a102d544b3cd1b4f3e4b2c4, type: 2}
    sentence: "\uC6D0\uB798 \uAC19\uC740 \uC18C\uB9AC\uD558\uB124...."
