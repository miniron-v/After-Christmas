  participants:
  - {fileID: 11400000, guid: 9ab2da8d8a102d544b3cd1b4f3e4b2c4, type: 2}
  dialogueLines:
  - speaker: {fileID: 11400000, guid: 9ab2da8d8a102d544b3cd1b4f3e4b2c4, type: 2}
    sentence: "\uAC11\uC790\uAE30 \uC815\uD6C8\uC758 \uD734\uB300\uD3F0\uC774 \uC6B8\uB9B0\uB2E4.
      \uBB38\uC790\uC600\uB2E4."
  - speaker: {fileID: 11400000, guid: 9ab2da8d8a102d544b3cd1b4f3e4b2c4, type: 2}
    sentence: "\uB538\uC774 \uBCF4\uB0B8 \uBB38\uC790\uC5D4 \uC790\uC2E0\uC758 \uC5BC\uAD74\uC774
      \uB098\uC628 \uC0AC\uC9C4\uC774 \uC2E4\uB824 \uC788\uB2E4. \uB538\uC758 \uC5BC\uAD74
      \uB4A4\uB85C \uC9D0\uC744 \uD480\uACE0 \uC788\uB294 \uC544\uB0B4\uC758 \uBAA8\uC2B5\uC774
      \uBCF4\uC778\uB2E4."
  - speaker: {fileID: 11400000, guid: 9ab2da8d8a102d544b3cd1b4f3e4b2c4, type: 2}
    sentence: "\uC798 \uB3C4\uCC29\uD588\uB098\uBCF4\uB124. \uB2E4\uD589\uC774\uB2E4."
  - speaker: {fileID: 11400000, guid: 9ab2da8d8a102d544b3cd1b4f3e4b2c4, type: 2}
    sentence: "\uC88B\uC544. \uB098\uB3C4 \uD798\uB0B4\uC11C \uB9C8\uC800 \uCCAD\uC18C\uD574\uBCFC\uAE4C!"
