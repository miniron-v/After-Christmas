  - speaker: {fileID: 11400000, guid: 005d17647ede0cf4fbe5c227785ba4a1, type: 2}
    sentence: "\uC790\uB124\uB3C4 \uAC00\uC57C\uC9C0! \uC5B4\uCC28\uD53C \uC9D1\uC5D0
      \uAC00\uBD24\uC790 \uC544\uBB34\uB3C4 \uC5C6\uC796\uC544?"
  - speaker: {fileID: 11400000, guid: 9ab2da8d8a102d544b3cd1b4f3e4b2c4, type: 2}
    sentence: "\uD558\uD558. \uADF8\uB7F4\uAE4C\uC694?"
