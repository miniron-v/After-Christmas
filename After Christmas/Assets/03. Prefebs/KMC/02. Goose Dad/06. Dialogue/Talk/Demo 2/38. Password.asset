  dialogueID: 0
  prerequisiteCondition: {fileID: 0}
  failSafeDialogue: {fileID: 11400000}
  participants:
  - {fileID: 11400000, guid: 9ab2da8d8a102d544b3cd1b4f3e4b2c4, type: 2}
  - {fileID: 11400000, guid: 9058d4f4d69dc3f4ab9ab05f3a7b1440, type: 2}
  - {fileID: 11400000, guid: 585a87079d093384c9f63144a979b674, type: 2}
  dialogueLines:
  - speaker: {fileID: 11400000, guid: 585a87079d093384c9f63144a979b674, type: 2}
    sentence: "\uC624\uB298\uC740 \uC544\uBE60 \uC0DD\uC77C\uC774\uB2C8\uAE4C, \uC9C0\uAC11
      \uC555\uC218!"
  - speaker: {fileID: 11400000, guid: 9ab2da8d8a102d544b3cd1b4f3e4b2c4, type: 2}
    sentence: "\uC9C0\uD604\uC544, \uC870\uC2EC\uD574! \uADF8\uAC70 \uC544\uBE60\uAC00
      \uC81C\uC77C \uC544\uB07C\uB294 \uAC70\uC57C!"
  - speaker: {fileID: 11400000, guid: 585a87079d093384c9f63144a979b674, type: 2}
    sentence: "\uC54C\uC544. \uC80A\uC5C8\uC744 \uB54C \uC5C4\uB9C8\uAC00 \uC900
      \uAC70\uB77C\uBA70? \uAC71\uC815 \uB9C8. \uC548 \uB5A8\uC5B4\uD2B8\uB9B4\uAC8C."
  - speaker: {fileID: 11400000, guid: 9058d4f4d69dc3f4ab9ab05f3a7b1440, type: 2}
    sentence: ....
  - speaker: {fileID: 11400000, guid: 585a87079d093384c9f63144a979b674, type: 2}
    sentence: "\uC544, \uB098 \uBE60\uC838\uC904\uAE4C? \uC624\uB79C\uB9CC\uC5D0
      \uB458\uC774 \uB370\uC774\uD2B8\uD560\uB798?"
  - speaker: {fileID: 11400000, guid: 9058d4f4d69dc3f4ab9ab05f3a7b1440, type: 2}
    sentence: "\uB370\uC774\uD2B8\uB294 \uBB34\uC2A8. \uC4F8\uB370\uC5C6\uB294 \uC18C\uB9AC\uD558\uC9C0
      \uB9C8."
  - speaker: {fileID: 11400000, guid: 585a87079d093384c9f63144a979b674, type: 2}
    sentence: "\uB610 \uC544\uB2CC \uCC99\uD55C\uB2E4. \uC5C4\uB9C8 \uB9E4\uB144
      \uC544\uBE60 \uC0DD\uC77C\uB9CC \uAE30\uB2E4\uB9AC\uC796\uC544? \uD734\uB300\uD3F0
      \uBE44\uBC00\uBC88\uD638\uB3C4 \uC544\uBE60 \uC0DD\uC77C\uC774\uBA74\uC11C."
  - speaker: {fileID: 11400000, guid: 9058d4f4d69dc3f4ab9ab05f3a7b1440, type: 2}
    sentence: "\uC57C, \uB108 \uADF8\uAC70 \uC5B4\uB5BB\uAC8C \uC54C\uC558\uC5B4?!"
  - speaker: {fileID: 11400000, guid: 585a87079d093384c9f63144a979b674, type: 2}
    sentence: "\uB2E4~ \uC544\uB294 \uBC29\uBC95\uC774 \uC788\uC9C0."
  - speaker: {fileID: 11400000, guid: 9058d4f4d69dc3f4ab9ab05f3a7b1440, type: 2}
    sentence: "\uBC15\uC9C0\uD604! \uC5C4\uB9C8 \uD734\uB300\uD3F0 \uB9C8\uC74C\uB300\uB85C
      \uBCF4\uC9C0 \uB9D0\uB7AC\uC9C0!"
  - speaker: {fileID: 11400000, guid: 585a87079d093384c9f63144a979b674, type: 2}
    sentence: "\uD558\uD558\uD558\uD558\uD558!"
