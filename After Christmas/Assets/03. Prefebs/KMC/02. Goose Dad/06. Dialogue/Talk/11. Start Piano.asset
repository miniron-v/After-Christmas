  dialogueLines:
  - speaker: {fileID: 11400000, guid: 9058d4f4d69dc3f4ab9ab05f3a7b1440, type: 2}
    sentence: "\uD53C\uC544\uB178 \uC120\uC0DD\uB2D8\uC774 \uADF8\uB7EC\uB294\uB370,
      \uC218\uC5F0\uC774\uAC00 \uC74C\uC545\uC5D0 \uC7AC\uB2A5\uC774 \uC788\uB300."
  - speaker: {fileID: 11400000, guid: 9ab2da8d8a102d544b3cd1b4f3e4b2c4, type: 2}
    sentence: "\uC815\uB9D0? \uC5ED\uC2DC \uC6B0\uB9AC \uB538."
  - speaker: {fileID: 11400000, guid: 9058d4f4d69dc3f4ab9ab05f3a7b1440, type: 2}
    sentence: "...\uADF8\uB798\uC11C, \uC120\uC0DD\uB2D8\uC774 \uC720\uD559\uC744
      \uBCF4\uB0B4\uB294 \uAC74 \uC5B4\uB5BB\uB0D0\uACE0 \uD558\uC2DC\uB354\uB77C."
