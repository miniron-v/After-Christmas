%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1c24672a27f90a24fb333e3077219294, type: 3}
  m_Name: 50. Daughter Born
  m_EditorClassIdentifier: 
  dialogueID: 1
  prerequisiteCondition: {fileID: 0}
  failSafeDialogue: {fileID: 11400000}
  participants:
  - {fileID: 11400000, guid: 9ab2da8d8a102d544b3cd1b4f3e4b2c4, type: 2}
  - {fileID: 11400000, guid: 79c650beea40e15498b7eedffcc273d5, type: 2}
  dialogueLines:
  - speaker: {fileID: 11400000, guid: 9ab2da8d8a102d544b3cd1b4f3e4b2c4, type: 2}
    sentence: "\uC5B4\uCA5C \uC774\uB9AC \uADC0\uC5EC\uC6B8\uAE4C?"
  - speaker: {fileID: 11400000, guid: 9ab2da8d8a102d544b3cd1b4f3e4b2c4, type: 2}
    sentence: "\uADF8\uB7EC\uB2C8\uAE4C \uB9D0\uC57C. \uD558\uB8E8\uC885\uC77C \uBD10\uB3C4
      \uC548 \uC9C8\uB9B4 \uAC83 \uAC19\uC544."
  - speaker: {fileID: 11400000, guid: 9ab2da8d8a102d544b3cd1b4f3e4b2c4, type: 2}
    sentence: "\uC544\uC774\uAC00 \uB2F9\uC2E0\uC744 \uB2EE\uC544\uC11C \uADF8\uB7F0\uAC00?
      \uC5ED\uC2DC, \uC5C4\uB9C8\uAC00 \uBBF8\uC778\uC774\uC5B4\uC11C...."
  - speaker: {fileID: 11400000, guid: 9ab2da8d8a102d544b3cd1b4f3e4b2c4, type: 2}
    sentence: "\uB538\uC740 \uC544\uBE60\uB97C \uB2EE\uB294\uB2E4\uC796\uC544. \uC774\uAC70
      \uBD10. \uB208\uC740 \uB2F9\uC2E0\uC744 \uBE7C\uB2E4 \uBC15\uC558\uB294\uB370?"
  - speaker: {fileID: 11400000, guid: 9ab2da8d8a102d544b3cd1b4f3e4b2c4, type: 2}
    sentence: "\uC5D0\uC774, \uB098 \uB2EE\uC73C\uBA74 \uC548 \uB418\uC9C0! \uC6B0\uB9AC
      \uB538\uC740 \uC5C4\uB9C8 \uB2EE\uC544\uC11C \uC608\uC058\uAC8C \uC790\uB77C\uC57C\uC9C0."
  - speaker: {fileID: 11400000, guid: 9ab2da8d8a102d544b3cd1b4f3e4b2c4, type: 2}
    sentence: "\uB09C \uC6B0\uB9AC \uB538\uC774 \uB2F9\uC2E0\uC744 \uB354 \uB2EE\uC558\uC73C\uBA74
      \uC88B\uACA0\uC5B4."
  - speaker: {fileID: 11400000, guid: 9ab2da8d8a102d544b3cd1b4f3e4b2c4, type: 2}
    sentence: "...\uC544\uB0D0. \uADF8\uB798\uB3C4 \uC5ED\uC2DC \uB098\uBCF4\uB2E8
      \uB2F9\uC2E0\uC744 \uB2EE\uC558\uC73C\uBA74 \uC88B\uACA0\uC5B4."
  - speaker: {fileID: 11400000, guid: 9ab2da8d8a102d544b3cd1b4f3e4b2c4, type: 2}
    sentence: "\uB098\uCC98\uB7FC \uC88B\uC544\uD558\uB294 \uAC74 \uC88B\uC544\uD55C\uB2E4,
      \uC81C\uB300\uB85C \uB9D0\uB3C4 \uBABB \uD558\uB294 \uAC83\uBCF4\uB2E8, \uB2F9\uC2E0\uCC98\uB7FC
      \uC194\uC9C1\uD55C \uC0AC\uB78C\uC774 \uB354 \uC88B\uC73C\uB2C8\uAE4C."
  - speaker: {fileID: 11400000, guid: 9ab2da8d8a102d544b3cd1b4f3e4b2c4, type: 2}
    sentence: "\uB610 \uADF8 \uC18C\uB9AC\uC57C? \uC608\uC804\uC5D0\uB3C4 \uB9D0\uD588\uC9C0\uB9CC...."
  - speaker: {fileID: 11400000, guid: 9ab2da8d8a102d544b3cd1b4f3e4b2c4, type: 2}
    sentence: "\uC54C\uC544. \uADF8\uB798\uB3C4, \uB9D0\uB85C \uD560 \uC904 \uC544\uB294
      \uAC74 \uC911\uC694\uD558\uB2C8\uAE4C."
  - speaker: {fileID: 11400000, guid: 9ab2da8d8a102d544b3cd1b4f3e4b2c4, type: 2}
    sentence: "...\uBB34\uC5C7\uBCF4\uB2E4, \uC6B0\uB9AC \uB538\uAE4C\uC9C0 \uB098\uCC98\uB7FC
      \uBB34\uB69D\uB69D\uD558\uBA74, \uB2F9\uC2E0\uC774 \uB108\uBB34 \uD798\uB4E4\uC5B4\uC9C0\uC796\uC544."
  - speaker: {fileID: 11400000, guid: 9ab2da8d8a102d544b3cd1b4f3e4b2c4, type: 2}
    sentence: "\uD798\uB4E4\uAE34 \uBB34\uC2A8. \uC6B0\uB9AC \uC5F0\uC560 \uB54C
      \uAE30\uC5B5 \uC548 \uB098? \uB09C \uB2F9\uC2E0 \uC5BC\uAD74\uB9CC \uBD10\uB3C4
      \uD589\uBCF5\uD588\uB294\uB370?"
  - speaker: {fileID: 11400000, guid: 9ab2da8d8a102d544b3cd1b4f3e4b2c4, type: 2}
    sentence: "\uADF8\uB798\uB3C4."
  - speaker: {fileID: 11400000, guid: 9ab2da8d8a102d544b3cd1b4f3e4b2c4, type: 2}
    sentence: "\uAD1C\uCC2E\uC544. \uB538\uC774 \uB2F9\uC2E0\uCC98\uB7FC \uBB34\uB69D\uB69D\uD558\uBA74,
      \uB0B4\uAC00 \uB2F9\uC2E0\uC5D0\uAC8C \uADF8\uB7AC\uB4EF, \uBA3C\uC800 \uB2E4\uAC00\uAC00\uC11C
      \uCE5C\uD574\uC9C0\uBA74 \uB418\uB2C8\uAE4C."
  - speaker: {fileID: 11400000, guid: 9ab2da8d8a102d544b3cd1b4f3e4b2c4, type: 2}
    sentence: "\uAD1C\uCC2E\uAE34.... \uC560\uAC00 \uC0AC\uCD98\uAE30\uAC00 \uC640\uC11C
      \uB2F9\uC2E0\uC774 \uC2EB\uB2E4\uD574\uB3C4?"
  - speaker: {fileID: 11400000, guid: 9ab2da8d8a102d544b3cd1b4f3e4b2c4, type: 2}
    sentence: "...\uADF8\uAC74, \uC880 \uD798\uB4E4\uC9C0\uB3C4...."
  - speaker: {fileID: 11400000, guid: 9ab2da8d8a102d544b3cd1b4f3e4b2c4, type: 2}
    sentence: "...\uC788\uC796\uC544. \uD639\uC2DC\uB77C\uB3C4 \uD798\uB4E0 \uC77C\uC774
      \uC0DD\uAE30\uBA74, \uAF2D \uB098\uD55C\uD14C \uB9D0\uD574\uC918."
  - speaker: {fileID: 11400000, guid: 9ab2da8d8a102d544b3cd1b4f3e4b2c4, type: 2}
    sentence: "\uC5D0\uC774, \uB098 \uC815\uB9D0 \uAD1C\uCC2E\uB2E4\uB2C8\uAE4C?"
  - speaker: {fileID: 11400000, guid: 9ab2da8d8a102d544b3cd1b4f3e4b2c4, type: 2}
    sentence: "\uB0B4\uAC00 \uC548 \uAD1C\uCC2E\uC544\uC11C \uADF8\uB798. \uB2F9\uC2E0\uB3C4
      \uC0AC\uB78C\uC778\uB370, \uC678\uB85C\uC6B4 \uB0A0\uB3C4 \uC788\uC5C8\uC744
      \uAC70\uC796\uC544."
  - speaker: {fileID: 11400000, guid: 9ab2da8d8a102d544b3cd1b4f3e4b2c4, type: 2}
    sentence: "\uB2F9\uC2E0\uC774 \uB098\uBE60\uC11C\uAC00 \uC544\uB2C8\uB77C, \uC720\uB3C5
      \uADF8\uB0A0\uB530\uB77C \uD798\uB4E4\uC5B4\uC11C,"
