  - speaker: {fileID: 11400000, guid: 22d606ec3d6e3044d9ac351a2f4f229b, type: 2}
    sentence: "\uD45C\uC9C0\uC5D0 \uC81C\uBAA9\uC5C6\uC774 \uC2ED\uC790\uAC00 \uBAA8\uC591\uB9CC
