  dialogueLines:
  - speaker: {fileID: 11400000, guid: 585a87079d093384c9f63144a979b674, type: 2}
    sentence: "\uBC8C\uC368 \uACB0\uD63C\uAE30\uB150\uC77C\uC774\uB77C\uB2C8."
  - speaker: {fileID: 11400000, guid: 9058d4f4d69dc3f4ab9ab05f3a7b1440, type: 2}
    sentence: "\uC9C0\uD604\uC774 \uB108 \uACB0\uD63C\uAE30\uB150\uC77C\uB3C4 \uC54C\uC544?"
  - speaker: {fileID: 11400000, guid: 585a87079d093384c9f63144a979b674, type: 2}
    sentence: "\uC5B4\uB5BB\uAC8C \uBAB0\uB77C? \uC5C4\uB9C8 \uBE44\uBC00\uBC88\uD638\uAC00
      \uC8C4\uB2E4 \uC624\uB298\uC778\uB370."
  - speaker: {fileID: 11400000, guid: 9058d4f4d69dc3f4ab9ab05f3a7b1440, type: 2}
    sentence: "\uB108 \uADF8\uAC70 \uC5B4\uB5BB\uAC8C \uC54C\uC558\uC5B4?!"
  - speaker: {fileID: 11400000, guid: 585a87079d093384c9f63144a979b674, type: 2}
    sentence: "\uC5C4\uB9C8 \uD734\uB300\uD3F0 \uBE44\uBC00\uBC88\uD638\uB3C4 0927\uC774\uC796\uC544?
      \uADF8 \uC815\uB3C4\uC57C \uAE30\uBCF8\uC774\uC9C0, \uBB50."
  - speaker: {fileID: 11400000, guid: 9058d4f4d69dc3f4ab9ab05f3a7b1440, type: 2}
    sentence: "\uC57C, \uB108 \uC774\uB9AC \uC640!"
