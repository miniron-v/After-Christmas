  dialogueID: 0
  prerequisiteCondition: {fileID: 0}
  failSafeDialogue: {fileID: 11400000}
  participants:
  - {fileID: 11400000, guid: 9ab2da8d8a102d544b3cd1b4f3e4b2c4, type: 2}
  - {fileID: 11400000, guid: 005d17647ede0cf4fbe5c227785ba4a1, type: 2}
  - {fileID: 11400000, guid: 987e42df4611eff46ac4e3e4b8260897, type: 2}
  dialogueLines:
  - speaker: {fileID: 11400000, guid: 005d17647ede0cf4fbe5c227785ba4a1, type: 2}
    sentence: "\uC790\uC790, 3\uCC28\uB294 \uB178\uB798\uBC29 \uC5B4\uB54C? \uB178\uB798\uBC29!"
  - speaker: {fileID: 11400000, guid: 987e42df4611eff46ac4e3e4b8260897, type: 2}
    sentence: "\uC544\uC720, \uB178\uB798\uBC29 \uC88B\uC8E0! \uB9E8\uB0A0 \uAC00\uB358
      \uAC70\uAE30 \uC5B4\uB5A0\uC2ED\uB2C8\uAE4C?"
  - speaker: {fileID: 11400000, guid: 005d17647ede0cf4fbe5c227785ba4a1, type: 2}
    sentence: "\uB2F9\uC5F0\uD788 \uAC70\uAE30\uB85C \uAC00\uC57C\uC9C0. \uBC15 \uCC28\uC7A5\uB3C4
      \uB2F9\uC5F0\uD788 \uAC08 \uAC70\uC9C0?"
  - speaker: {fileID: 11400000, guid: 005d17647ede0cf4fbe5c227785ba4a1, type: 2}
    sentence: "\uC5B4, \uC5EC\uBCF4. \uC544, \uADF8\uAC8C \uC624\uB298\uC740 \uD68C\uC2DD\uC774...."
  - speaker: {fileID: 11400000, guid: 005d17647ede0cf4fbe5c227785ba4a1, type: 2}
    sentence: "\uC544\uB098, \uB0B4\uAC00 \uC65C \uADF8\uB7EC\uACA0\uC5B4. \uADF8\uCE58\uB9CC
      \uD68C\uC2DD\uB3C4 \uC77C\uC758 \uC5F0\uC7A5\uC120\u3147...."
  - speaker: {fileID: 11400000, guid: 005d17647ede0cf4fbe5c227785ba4a1, type: 2}
    sentence: "\uC54C\uC558\uC5B4. \uC9C0\uAE08 \uBC14\uB85C \uB4E4\uC5B4\uAC08\uAC8C."
