  m_Script: {fileID: 11500000, guid: 1c24672a27f90a24fb333e3077219294, type: 3}
  m_Name: 37. Busy Morning
  m_EditorClassIdentifier: 
  dialogueID: 0
  prerequisiteCondition: {fileID: 0}
  failSafeDialogue: {fileID: 11400000}
  participants:
  - {fileID: 11400000, guid: 9ab2da8d8a102d544b3cd1b4f3e4b2c4, type: 2}
  - {fileID: 11400000, guid: 9058d4f4d69dc3f4ab9ab05f3a7b1440, type: 2}
  - {fileID: 11400000, guid: 585a87079d093384c9f63144a979b674, type: 2}
  dialogueLines:
  - speaker: {fileID: 11400000, guid: 9058d4f4d69dc3f4ab9ab05f3a7b1440, type: 2}
    sentence: "\uC9C0\uD604\uC544, \uC544\uCE68 \uBA39\uACE0 \uAC00\uC57C\uC9C0!"
  - speaker: {fileID: 11400000, guid: 585a87079d093384c9f63144a979b674, type: 2}
    sentence: "\uB2A6\uC5C8\uC5B4!"
  - speaker: {fileID: 11400000, guid: 9058d4f4d69dc3f4ab9ab05f3a7b1440, type: 2}
    sentence: "\uC5B4\uD734, \uC815\uB9D0...."
  - speaker: {fileID: 11400000, guid: 9ab2da8d8a102d544b3cd1b4f3e4b2c4, type: 2}
    sentence: "\uD558\uD558, \uB098\uB3C4 \uD559\uAD50 \uB2E4\uB2D0 \uB54C \uB9E8\uB0A0
      \uC800\uB7AC\uC5C8\uB294\uB370."
  - speaker: {fileID: 11400000, guid: 9058d4f4d69dc3f4ab9ab05f3a7b1440, type: 2}
    sentence: "\uC7AC\uBC0C\uC5B4?"
  - speaker: {fileID: 11400000, guid: 9ab2da8d8a102d544b3cd1b4f3e4b2c4, type: 2}
    sentence: "...\uD5D9."
  - speaker: {fileID: 11400000, guid: 9058d4f4d69dc3f4ab9ab05f3a7b1440, type: 2}
    sentence: "...\uC870\uC2EC\uD574\uC11C \uB2E4\uB140\uC640."
  - speaker: {fileID: 11400000, guid: 9ab2da8d8a102d544b3cd1b4f3e4b2c4, type: 2}
    sentence: "\uB2E4\uB140\uC62C\uAC8C. \uC0AC\uB791\uD574, \uC5EC\uBCF4."
  - speaker: {fileID: 11400000, guid: 9058d4f4d69dc3f4ab9ab05f3a7b1440, type: 2}
    sentence: "\uB098\uB3C4."
  - speaker: {fileID: 11400000, guid: 585a87079d093384c9f63144a979b674, type: 2}
    sentence: "\uC73C, \uB2ED\uC0B4."
