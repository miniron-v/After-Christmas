%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1c24672a27f90a24fb333e3077219294, type: 3}
  m_Name: 23. Class Reunion
  m_EditorClassIdentifier: 
  dialogueID: 0
  prerequisiteCondition: {fileID: 0}
  failSafeDialogue: {fileID: 11400000}
  participants:
  - {fileID: 11400000, guid: 9ab2da8d8a102d544b3cd1b4f3e4b2c4, type: 2}
  - {fileID: 11400000, guid: 676254e7aa7eb764aba7cb6d93ddf024, type: 2}
  dialogueLines:
  - speaker: {fileID: 11400000, guid: 676254e7aa7eb764aba7cb6d93ddf024, type: 2}
    sentence: "\uC774\uC57C, \uC624\uC131\uC804\uC790 \uCC28\uC7A5?"
  - speaker: {fileID: 11400000, guid: 676254e7aa7eb764aba7cb6d93ddf024, type: 2}
    sentence: "\uB300\uAE30\uC5C5 \uCC28\uC7A5\uC5D0, \uB538\uC740 \uC720\uB7FD\uC5D0
      \uC720\uD559\uAE4C\uC9C0. \uBC15\uC131\uD6C8 \uC644\uC804 \uC131\uACF5\uD588\uB124!"
  - speaker: {fileID: 11400000, guid: 9ab2da8d8a102d544b3cd1b4f3e4b2c4, type: 2}
    sentence: "\uC5D0\uC774, \uC131\uACF5\uC740 \uBB34\uC2A8."
  - speaker: {fileID: 11400000, guid: 676254e7aa7eb764aba7cb6d93ddf024, type: 2}
    sentence: '....

'
  - speaker: {fileID: 11400000, guid: 8b42e8caee73953478515d20c4f2cc55, type: 2}
    sentence: "\uC57C, \uB538\uB0B4\uBBF8 \uC720\uD559\uC5D0 \uC640\uC774\uD504\uAE4C\uC9C0
      \uB530\uB77C\uAC14\uB2E4\uACE0?"
  - speaker: {fileID: 11400000, guid: 8b42e8caee73953478515d20c4f2cc55, type: 2}
    sentence: "\uADF8\uB7FC \uADF8\uB0E5 \uAE30\uB7EC\uAE30 \uC544\uBE60 \uC544\uB2C8\uB0D0?
      \uC131\uACF5\uC740 \uBB34\uC2A8...."
  - speaker: {fileID: 11400000, guid: 9ab2da8d8a102d544b3cd1b4f3e4b2c4, type: 2}
    sentence: "\uBB50?"
  - speaker: {fileID: 11400000, guid: 676254e7aa7eb764aba7cb6d93ddf024, type: 2}
    sentence: "\uC57C, \uBD80\uB7EC\uC6B0\uBA74 \uADF8\uB0E5 \uBD80\uB7FD\uB2E4 \uD574!
      \uCD94\uD558\uAC8C \uBB50\uB0D0?"
  - speaker: {fileID: 11400000, guid: 8b42e8caee73953478515d20c4f2cc55, type: 2}
    sentence: "\uBD80\uB7FD\uAE34 \uAC1C\uBFD4. \uB0B4\uAC00 \uBB50 \uD2C0\uB9B0
      \uB9D0 \uD588\uB0D0?"
  - speaker: {fileID: 11400000, guid: 8b42e8caee73953478515d20c4f2cc55, type: 2}
    sentence: "\uC57C, \uC694\uC998 \uB108\uAC19\uC740 \uC560\uB4E4\uC744 \uBB50\uB77C
      \uBD80\uB974\uB294 \uC904 \uC544\uB0D0? ATM\uC774\uB780\uB2E4, ATM! \uB204\uB974\uBA74
      \uB3C8 \uB098\uC624\uB294 \uAE30\uACC4!"
  - speaker: {fileID: 11400000, guid: 8b42e8caee73953478515d20c4f2cc55, type: 2}
    sentence: "\uB2C8\uB124 \uB9C8\uB204\uB77C\uB098 \uB538\uB0B4\uBBF8\uB098, \uC0DD\uAC01\uC774
      \uC788\uC73C\uBA74 \uC9C0 \uC560\uBE44\uB9CC \uBC84\uB824\uB193\uACE0 \uC720\uD559\uC744
      \uAC14\uACA0\uB0D0? \uADF8\uB0E5 \uB2C8\uAC00 \uAC00\uC7A5 \uCDE8\uAE09 \uBABB
      \uBC1B\uB294 \uAC70\uC57C, \uC778\uB9C8!"
  - speaker: {fileID: 11400000, guid: 9ab2da8d8a102d544b3cd1b4f3e4b2c4, type: 2}
    sentence: "\uB108 \uC774 \u3146...!"
  - speaker: {fileID: 11400000, guid: 676254e7aa7eb764aba7cb6d93ddf024, type: 2}
    sentence: "\uC57C, \uC57C! \uB9D0\uB824!"
