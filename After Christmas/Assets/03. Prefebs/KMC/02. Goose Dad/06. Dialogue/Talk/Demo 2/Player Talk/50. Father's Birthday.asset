  m_Script: {fileID: 11500000, guid: 1c24672a27f90a24fb333e3077219294, type: 3}
  m_Name: 50. Father's Birthday
  m_EditorClassIdentifier: 
  dialogueID: 0
  prerequisiteCondition: {fileID: 0}
  failSafeDialogue: {fileID: 11400000}
  participants:
  - {fileID: 11400000, guid: 18983c6cf05ee4040bef40d61c29cc7d, type: 2}
  - {fileID: 11400000, guid: 3546db6422f82da45b4b98162056c5eb, type: 2}
  dialogueLines:
  - speaker: {fileID: 11400000, guid: 451b76c89f930db4fb8d72cc3b556d81, type: 2}
    sentence: "\uC790."
  - speaker: {fileID: 11400000, guid: 9ab2da8d8a102d544b3cd1b4f3e4b2c4, type: 2}
    sentence: "\uC5B4? \uBB50\uC57C? \uC6EC \uC9C0\uAC11?"
  - speaker: {fileID: 11400000, guid: 451b76c89f930db4fb8d72cc3b556d81, type: 2}
    sentence: "\uC624\uB298 \uC0DD\uC77C\uC774\uC796\uC544? ...\uC120\uBB3C."
  - speaker: {fileID: 11400000, guid: 451b76c89f930db4fb8d72cc3b556d81, type: 2}
    sentence: "...5\uC6D4 27\uC77C \uC544\uB0D0?"
  - speaker: {fileID: 11400000, guid: 9ab2da8d8a102d544b3cd1b4f3e4b2c4, type: 2}
    sentence: "\uC544\uB0D0, \uB9DE\uC544. \uADFC\uB370... \uC5B4\uB5BB\uAC8C \uC54C\uC558\uC5B4?
      \uB0B4\uAC00 \uB9D0\uD574\uC92C\uB358\uAC00?"
  - speaker: {fileID: 11400000, guid: 451b76c89f930db4fb8d72cc3b556d81, type: 2}
    sentence: "\uADF8\uB0E5. \uC544\uB294 \uBC29\uBC95\uC774 \uC788\uC5B4."
  - speaker: {fileID: 11400000, guid: 9ab2da8d8a102d544b3cd1b4f3e4b2c4, type: 2}
    sentence: "...! \uACE0\uB9C8\uC6CC. \uC774\uAC70 \uBE44\uC2FC \uAC70 \uC544\uB0D0?"
  - speaker: {fileID: 11400000, guid: 451b76c89f930db4fb8d72cc3b556d81, type: 2}
    sentence: "\uBCC4\uB85C \uC548 \uBE44\uC2F8."
  - speaker: {fileID: 11400000, guid: 9ab2da8d8a102d544b3cd1b4f3e4b2c4, type: 2}
    sentence: "\uD5E4\uD5E4... \uACE0\uB9C8\uC6CC. \uD3C9\uC0DD \uBCF4\uBB3C\uB85C
      \uAC04\uC9C1\uD560\uAC8C."
  - speaker: {fileID: 11400000, guid: 451b76c89f930db4fb8d72cc3b556d81, type: 2}
    sentence: "\uAC04\uC9C1\uB9CC \uD558\uC9C0 \uB9D0\uACE0, \uB4E4\uACE0 \uB2E4\uB140."
  - speaker: {fileID: 11400000, guid: 9ab2da8d8a102d544b3cd1b4f3e4b2c4, type: 2}
    sentence: "\uC54C\uC558\uC5B4. \uB2F3\uC544 \uC5C6\uC5B4\uC9C8 \uB54C\uAE4C\uC9C0,
      \uC774\uAC70\uB9CC \uC4F8\uAC8C. \uACE0\uB9C8\uC6CC."
