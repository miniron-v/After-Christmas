  - speaker: {fileID: 11400000, guid: 005d17647ede0cf4fbe5c227785ba4a1, type: 2}
    sentence: "\uC81C\uC77C \uD798\uB4E4 \uB54C\uB124. \uB098\uB3C4 \uC9D1\uC0AC\uB78C
