  participants:
  - {fileID: 11400000, guid: 9ab2da8d8a102d544b3cd1b4f3e4b2c4, type: 2}
  - {fileID: 11400000, guid: 451b76c89f930db4fb8d72cc3b556d81, type: 2}
  dialogueLines:
  - speaker: {fileID: 11400000, guid: 9ab2da8d8a102d544b3cd1b4f3e4b2c4, type: 2}
    sentence: "\uC800, \uC800\uAE30!"
  - speaker: {fileID: 11400000, guid: 451b76c89f930db4fb8d72cc3b556d81, type: 2}
    sentence: "\uB124?"
  - speaker: {fileID: 11400000, guid: 9ab2da8d8a102d544b3cd1b4f3e4b2c4, type: 2}
    sentence: "\uAD1C\uCC2E\uC73C\uC2DC\uBA74 \uC800\uB791 \uBC25 \uD55C \uB07C \uD558\uC2DC\uACA0\uC2B5\uB2C8\uAE4C?"
  - speaker: {fileID: 11400000, guid: 451b76c89f930db4fb8d72cc3b556d81, type: 2}
    sentence: "\uC544...."
  - speaker: {fileID: 11400000, guid: 451b76c89f930db4fb8d72cc3b556d81, type: 2}
    sentence: "\uC8C4\uC1A1\uD574\uC694. \uC81C\uAC00 \uB2E4\uC74C \uC218\uC5C5\uC774
      \uC788\uC5B4\uC11C...."
  - speaker: {fileID: 11400000, guid: 9ab2da8d8a102d544b3cd1b4f3e4b2c4, type: 2}
    sentence: "\uC544...."
  - speaker: {fileID: 11400000, guid: 9ab2da8d8a102d544b3cd1b4f3e4b2c4, type: 2}
    sentence: "\uADF8, \uADF8\uB7EC\uBA74 \uB2E4\uB978 \uB0A0\uC774\uB77C\uB3C4 \uAD1C\uCC2E\uC73C\uB2C8\uAE4C,
      \uC5B4\uB5BB\uAC8C \uC548 \uB420\uAE4C\uC694?"
  - speaker: {fileID: 11400000, guid: 9ab2da8d8a102d544b3cd1b4f3e4b2c4, type: 2}
    sentence: "\uC544\uB2C8\uBA74 \uC090\uC090 \uBC88\uD638\uB77C\uB3C4...."
