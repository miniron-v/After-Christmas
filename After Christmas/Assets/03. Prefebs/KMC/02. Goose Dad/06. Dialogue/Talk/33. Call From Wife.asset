  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1c24672a27f90a24fb333e3077219294, type: 3}
  m_Name: 33. Call From Wife
  m_EditorClassIdentifier: 
  dialogueID: 0
  prerequisiteCondition: {fileID: 0}
  failSafeDialogue: {fileID: 11400000}
  participants:
  - {fileID: 11400000, guid: 9ab2da8d8a102d544b3cd1b4f3e4b2c4, type: 2}
  dialogueLines:
  - speaker: {fileID: 11400000, guid: 9ab2da8d8a102d544b3cd1b4f3e4b2c4, type: 2}
    sentence: '!'
  - speaker: {fileID: 11400000, guid: 9ab2da8d8a102d544b3cd1b4f3e4b2c4, type: 2}
    sentence: "\uC6EC\uC77C\uC774\uC57C? \uB2F9\uC2E0\uC774 \uBA3C\uC800 \uC804\uD654\uB3C4
      \uD574\uC8FC\uACE0."
  - speaker: {fileID: 11400000, guid: 9ab2da8d8a102d544b3cd1b4f3e4b2c4, type: 2}
    sentence: "\uB098? \uC644\uC804 \uC798 \uC9C0\uB0B4\uC9C0! \uC694\uC998 \uC778\uAE30\uAC00
      \uB108\uBB34 \uB9CE\uC544\uC11C \uBB38\uC81C\uB77C\uB2C8\uAE4C."
  - speaker: {fileID: 11400000, guid: 9ab2da8d8a102d544b3cd1b4f3e4b2c4, type: 2}
    sentence: "\uC678\uB86D\uAE34 \uBB34\uC2A8. \uCE5C\uAD6C\uB4E4\uC774 \uC790\uAFB8
      \uBABB \uBD88\uB7EC\uB0B4\uC11C \uC548\uB2EC\uC774\uC57C. \uD68C\uC0AC\uC0AC\uB78C\uB4E4\uB3C4
      \uB0A0 \uC5BC\uB9C8\uB098 \uC88B\uC544\uD558\uB294\uB370."
  - speaker: {fileID: 11400000, guid: 9ab2da8d8a102d544b3cd1b4f3e4b2c4, type: 2}
    sentence: "\uB2F9\uC2E0\uC740 \uC5B4\uB54C? \uB3C5\uC77C \uC0DD\uD65C \uD798\uB4E4\uC9C0
      \uC54A\uC544?"
  - speaker: {fileID: 11400000, guid: 9ab2da8d8a102d544b3cd1b4f3e4b2c4, type: 2}
    sentence: "\uC751. \uC751. \uC544, \uC0DD\uD65C\uBE44?"
  - speaker: {fileID: 11400000, guid: 9ab2da8d8a102d544b3cd1b4f3e4b2c4, type: 2}
    sentence: "\uC544\uB0D0\uC544\uB0D0, \uBBF8\uC548\uD558\uAE34. \uAE08\uBC29 \uBCF4\uB0BC\uAC8C."
  - speaker: {fileID: 11400000, guid: 9ab2da8d8a102d544b3cd1b4f3e4b2c4, type: 2}
    sentence: "\uC5D0\uC774, \uAD1C\uCC2E\uC544. \uB098\uB294 \uC694\uC998 \uB3C8
      \uC4F8 \uACF3\uB3C4 \uC5C6\uB294 \uAC78."
  - speaker: {fileID: 11400000, guid: 9ab2da8d8a102d544b3cd1b4f3e4b2c4, type: 2}
    sentence: "\uC751. \uC9C0\uD604\uC774\uB3C4 \uC798 \uC9C0\uB0B4\uC9C0?"
  - speaker: {fileID: 11400000, guid: 9ab2da8d8a102d544b3cd1b4f3e4b2c4, type: 2}
    sentence: "\uC5B4\uC5B4, \uC54C\uC558\uC5B4. \uC0AC\uB791\uD574."
  - speaker: {fileID: 11400000, guid: 9ab2da8d8a102d544b3cd1b4f3e4b2c4, type: 2}
    sentence: ....
  - speaker: {fileID: 11400000, guid: 8b42e8caee73953478515d20c4f2cc55, type: 2}
    sentence: "\uC57C, \uC694\uC998 \uB108\uAC19\uC740 \uC560\uB4E4\uC744 \uBB50\uB77C
      \uBD80\uB974\uB294 \uC904 \uC544\uB0D0? ATM\uC774\uB780\uB2E4, ATM! \uB204\uB974\uBA74
      \uB3C8 \uB098\uC624\uB294 \uAE30\uACC4!"
  - speaker: {fileID: 11400000, guid: 9ab2da8d8a102d544b3cd1b4f3e4b2c4, type: 2}
    sentence: "\uC5D0\uC774, \uC544\uB0D0. \uB0B4 \uAC00\uC871\uC740 \uB0B4\uAC00
      \uB354 \uC798 \uC54C\uC544."
