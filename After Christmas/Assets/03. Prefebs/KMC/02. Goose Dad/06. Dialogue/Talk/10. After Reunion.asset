  participants:
  - {fileID: 11400000, guid: 9ab2da8d8a102d544b3cd1b4f3e4b2c4, type: 2}
  dialogueLines:
  - speaker: {fileID: 11400000, guid: 9ab2da8d8a102d544b3cd1b4f3e4b2c4, type: 2}
    sentence: "\uC57C, \uC57C. \uC774\uC81C \uADF8\uB9CC \uD654 \uD480\uC5B4."
  - speaker: {fileID: 11400000, guid: 9ab2da8d8a102d544b3cd1b4f3e4b2c4, type: 2}
    sentence: "\uC194\uC9C1\uD788 \uAC54\uAC00 \uC798\uBABB\uD55C \uAC74 \uB9DE\uC9C0\uB9CC,
      \uC5B4\uB5BB\uAC8C \uC560\uB97C \uADF8 \uC9C0\uACBD\uAE4C\uC9C0 \uD328\uB0D0."
  - speaker: {fileID: 11400000, guid: 9ab2da8d8a102d544b3cd1b4f3e4b2c4, type: 2}
    sentence: "\uD558....\n"
  - speaker: {fileID: 11400000, guid: 9ab2da8d8a102d544b3cd1b4f3e4b2c4, type: 2}
    sentence: "\uC65C \uB9D0\uB838\uB0D0? \uADF8\uB0E5 \uC8FD\uC5EC\uB1A8\uC5B4\uC57C
      \uD588\uB294\uB370."
  - speaker: {fileID: 11400000, guid: 9ab2da8d8a102d544b3cd1b4f3e4b2c4, type: 2}
    sentence: "\uC6B0\uB9AC \uC640\uC774\uD504\uB791 \uC9C0\uD604\uC774 \uBCF8 \uC801\uB3C4
      \uC5C6\uB294 \uB188\uC774, \uAC10\uD788 \uC6B0\uB9AC \uAC00\uC871\uC744 \uC695\uD574?
      \uC9C0\uAC00 \uBB58 \uC548\uB2E4\uACE0?"
