%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1c24672a27f90a24fb333e3077219294, type: 3}
  m_Name: 01. Start
  m_EditorClassIdentifier: 
  dialogueID: 0
  prerequisiteCondition: {fileID: 0}
  failSafeDialogue: {fileID: 11400000}
  participants:
  - {fileID: 11400000, guid: 18983c6cf05ee4040bef40d61c29cc7d, type: 2}
  - {fileID: 11400000, guid: 3546db6422f82da45b4b98162056c5eb, type: 2}
  dialogueLines:
  - speaker: {fileID: 11400000, guid: 18983c6cf05ee4040bef40d61c29cc7d, type: 2}
    sentence: "\uC5EC\uAE30\uAC00 \uAE30\uC5B5 \uC18D...!"
  - speaker: {fileID: 11400000, guid: 18983c6cf05ee4040bef40d61c29cc7d, type: 2}
    sentence: "\uADF8\uB7F0\uB370, \uAE30\uC5B5\uC5D0 \uB4E4\uC5B4\uC624\uBA74 \uD574\uB2F9
      \uC7A5\uBA74\uC774 \uC7AC\uC0DD\uB41C\uB2E4\uACE0 \uD588\uB294\uB370... \uC5EC\uAE34
      \uC548 \uC6C0\uC9C1\uC774\uB124\uC694?"
  - speaker: {fileID: 11400000, guid: 3546db6422f82da45b4b98162056c5eb, type: 2}
    sentence: "\uC5EC\uAE34 \uADE0\uC5F4\uC774 \uC788\uC796\uC544. \uAE68\uC9C4 \uAE30\uC5B5\uC740
      \uBCF5\uAD6C\uD558\uAE30 \uC804\uAE4C\uC9C4 \uC7AC\uC0DD\uB418\uC9C0 \uC54A\uC544."
  - speaker: {fileID: 11400000, guid: 3546db6422f82da45b4b98162056c5eb, type: 2}
    sentence: "...\uC7A0\uAE50, \uD22C\uC785\uB418\uAE30 \uC804\uC5D0 \uAD50\uC721
      \uC548 \uBC1B\uC558\uC5B4?"
  - speaker: {fileID: 11400000, guid: 18983c6cf05ee4040bef40d61c29cc7d, type: 2}
    sentence: "\uADF8\uAC8C.... \uBC1B\uAE34 \uD588\uB294\uB370\uC694, \uC0AC\uC2E4
      \uADF8\uB54C \uC0B4\uC9DD \uC878\uC544\uC11C..."
  - speaker: {fileID: 11400000, guid: 18983c6cf05ee4040bef40d61c29cc7d, type: 2}
    sentence: "\uC544\uC8FC \uC0B4\uC9DD...."
  - speaker: {fileID: 11400000, guid: 3546db6422f82da45b4b98162056c5eb, type: 2}
    sentence: .......
  - speaker: {fileID: 11400000, guid: 18983c6cf05ee4040bef40d61c29cc7d, type: 2}
    sentence: ......
  - speaker: {fileID: 11400000, guid: 3546db6422f82da45b4b98162056c5eb, type: 2}
    sentence: "\uCE58\uB8CC \uBC29\uBC95\uC740 \uC54C\uC9C0?"
  - speaker: {fileID: 11400000, guid: 18983c6cf05ee4040bef40d61c29cc7d, type: 2}
    sentence: "\uB124. \uAE68\uC838 \uC788\uB294 \uD575\uC2EC \uAE30\uC5B5\uC744
      \uCC3E\uC544\uC11C, \uBCF5\uAD6C\uD558\uBA74 \uB41C\uB2E4\uACE0 \uB4E4\uC5C8\uC5B4\uC694."
  - speaker: {fileID: 11400000, guid: 3546db6422f82da45b4b98162056c5eb, type: 2}
    sentence: "\uB9DE\uC544. \uC6B0\uB9AC\uC758 \uBAA9\uD45C\uB294, \uC774 \uC0AC\uB78C\uC758
      \uADFC\uAC04\uC744 \uC774\uB8E8\uB294 \uD575\uC2EC \uAE30\uC5B5. \uAC70\uAE30
      \uC0DD\uAE34 \uADE0\uC5F4\uC744 \uBA54\uC6B0\uB294 \uAC70\uC57C."
  - speaker: {fileID: 11400000, guid: 18983c6cf05ee4040bef40d61c29cc7d, type: 2}
    sentence: "\uC544, \uC5EC\uAE30 \uC774 \uCEE4\uB2E4\uB780 \uAC8C \uADE0\uC5F4\uC778\uAC00\uC694?"
  - speaker: {fileID: 11400000, guid: 3546db6422f82da45b4b98162056c5eb, type: 2}
    sentence: "\uADF8\uB798. \uAE30\uC5B5 \uC18D\uC5D0\uC11C \uC720\uB3C5 \uAC80\uAC8C
      \uCE60\uD574\uC9C4 \uBD80\uBD84\uC774 \uADE0\uC5F4\uC774\uC57C."
  - speaker: {fileID: 11400000, guid: 3546db6422f82da45b4b98162056c5eb, type: 2}
    sentence: "\uB2E4\uB978 \uAC74 \uB2E4 \uB5A0\uC624\uB974\uB294\uB370, \uB531
      \uC800 \uBD80\uBD84\uB9CC \uC0DD\uAC01\uC774 \uC548 \uB098\uB294 \uAC70\uC9C0.
      \uADF8\uB798\uC11C \uAE30\uC5B5 \uC18D\uC5D0\uC11C \uC911\uC694\uD55C \uBB3C\uAC74\uB4E4\uC744
      \uC218\uC9D1\uD574\uC11C, \uADE0\uC5F4\uB4E4\uC744 \uBA54\uC6B0\uB294 \uAC70\uC57C."
  - speaker: {fileID: 11400000, guid: 3546db6422f82da45b4b98162056c5eb, type: 2}
    sentence: "\uC774 \uC0AC\uB78C\uC5D0\uAC8C \uC758\uBBF8 \uC788\uB294 \uBB3C\uAC74\uC740
      \uAC00\uAE4C\uC774 \uAC00\uBA74 \uBE5B\uC774 \uB0A0 \uAC70\uC57C. \uBE5B\uB098\uB294
      \uBB3C\uCCB4\uB97C \uCC3E\uC544 E\uB97C \uB20C\uB7EC\uBCF4\uC790."
  - speaker: {fileID: 11400000, guid: 18983c6cf05ee4040bef40d61c29cc7d, type: 2}
    sentence: "E\uC694?"
  - speaker: {fileID: 11400000, guid: 3546db6422f82da45b4b98162056c5eb, type: 2}
    sentence: "\uADF8\uB7F0 \uAC8C \uC788\uC5B4."
