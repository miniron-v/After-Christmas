  participants:
  - {fileID: 11400000, guid: 9ab2da8d8a102d544b3cd1b4f3e4b2c4, type: 2}
  - {fileID: 11400000, guid: 451b76c89f930db4fb8d72cc3b556d81, type: 2}
  dialogueLines:
  - speaker: {fileID: 11400000, guid: 9ab2da8d8a102d544b3cd1b4f3e4b2c4, type: 2}
    sentence: "\uC601\uD654 \uC644\uC804 \uAE30\uB300\uB41C\uB2E4. \uADF8\uCE58?"
  - speaker: {fileID: 11400000, guid: 9ab2da8d8a102d544b3cd1b4f3e4b2c4, type: 2}
    sentence: "\uAC70\uB300 \uACE0\uB9B4\uB77C\uAC00 \uB098\uC624\uB294 \uC601\uD654\uB77C\uB2C8,
      \uBD84\uBA85 \uC7AC\uBC0C\uC744 \uAC70\uC57C!"
  - speaker: {fileID: 11400000, guid: 451b76c89f930db4fb8d72cc3b556d81, type: 2}
    sentence: "\uADF8\uB7EC\uAC8C. \uC7AC\uBC0C\uACA0\uB2E4."
  - speaker: {fileID: 11400000, guid: 9ab2da8d8a102d544b3cd1b4f3e4b2c4, type: 2}
    sentence: "\uAC71\uC815 \uB9C8. \uB0B4\uAC00 \uC0AC\uB294 \uAC70\uB2C8\uAE4C."
  - speaker: {fileID: 11400000, guid: 451b76c89f930db4fb8d72cc3b556d81, type: 2}
    sentence: "...\uC751. \uACE0\uB9C8\uC6CC."
