  - speaker: {fileID: 11400000, guid: 9ab2da8d8a102d544b3cd1b4f3e4b2c4, type: 2}
    sentence: "\uB538~. \uBB50\uD574?"
  - speaker: {fileID: 11400000, guid: 585a87079d093384c9f63144a979b674, type: 2}
    sentence: "\uC544, \uB178\uD06C \uD558\uB7AC\uC796\uC544!"
  - speaker: {fileID: 11400000, guid: 9ab2da8d8a102d544b3cd1b4f3e4b2c4, type: 2}
