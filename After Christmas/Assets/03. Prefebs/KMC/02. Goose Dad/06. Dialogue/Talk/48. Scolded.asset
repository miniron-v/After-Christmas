  - speaker: {fileID: 11400000, guid: 9ab2da8d8a102d544b3cd1b4f3e4b2c4, type: 2}
    sentence: "\uB098 \uC654\uC5B4~."
  - speaker: {fileID: 11400000, guid: 79c650beea40e15498b7eedffcc273d5, type: 2}
    sentence: "\uBB34\uC2A8 \uC77C \uC788\uC5B4? \uB9CE\uC774 \uD53C\uACE4\uD574\uBCF4\uC774\uB294\uB370?"
