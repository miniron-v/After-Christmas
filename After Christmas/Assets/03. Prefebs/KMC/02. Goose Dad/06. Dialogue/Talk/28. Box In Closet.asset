  m_Script: {fileID: 11500000, guid: 1c24672a27f90a24fb333e3077219294, type: 3}
  m_Name: 28. Box In Closet
  m_EditorClassIdentifier: 
  dialogueID: 0
  prerequisiteCondition: {fileID: 0}
  failSafeDialogue: {fileID: 11400000}
  participants:
  - {fileID: 11400000, guid: 9ab2da8d8a102d544b3cd1b4f3e4b2c4, type: 2}
  dialogueLines:
  - speaker: {fileID: 0}
    sentence: "\uBE44\uBC00\uBC88\uD638\uB294 \uC608\uC0C1\uB300\uB85C \uACB0\uD63C\uAE30\uB150\uC77C\uC774\uC5C8\uB2E4."
  - speaker: {fileID: 0}
    sentence: "\uC0C1\uC790 \uC548\uC5D4 \uAC01\uC885 \uD3B8\uC9C0\uC640 \uBE0C\uB85C\uCE58
      \uB4F1, \uC131\uD6C8\uC774 \uC9C0\uAE08\uAECF \uC120\uBB3C\uD574\uC900 \uBB3C\uAC74\uB4E4\uC774
      \uB4E4\uC5B4 \uC788\uC5C8\uB2E4."
  - speaker: {fileID: 11400000, guid: 9ab2da8d8a102d544b3cd1b4f3e4b2c4, type: 2}
    sentence: "\uD558\uD558, \uC774\uAC78 \uD558\uB098\uB3C4 \uC548 \uBC84\uB9AC\uACE0
      \uB2E4 \uAC04\uC9C1\uD558\uACE0 \uC788\uC5C8\uC5B4?"
  - speaker: {fileID: 0}
    sentence: "\uADF8\uC911\uC5D0\uC11C \uD2B9\uD788 \uBE48\uB098\uB294, \uB2E4\uC774\uC544\uBAAC\uB4DC\uAC00
      \uBC15\uD78C \uBC18\uC9C0\uAC00 \uB208\uC5D0 \uB748\uB2E4."
  - speaker: {fileID: 11400000, guid: 9ab2da8d8a102d544b3cd1b4f3e4b2c4, type: 2}
    sentence: "\uC774\uAC74.... \uD558\uD558. \uC774\uB0A0 \uC5C4\uCCAD \uB5A8\uB838\uC5C8\uB294\uB370.
      \uC785\uC73C\uB85C \uBA39\uB294\uC9C0 \uCF54\uB85C \uBA39\uB294\uC9C0, \uB9DB\uC774
      \uD558\uB098\uB3C4 \uC548 \uB290\uAEF4\uC84C\uC5C8\uC9C0."
