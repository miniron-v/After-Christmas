--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1c24672a27f90a24fb333e3077219294, type: 3}
  m_Name: 22-2. Propose
  m_EditorClassIdentifier: 
  dialogueID: 0
  prerequisiteCondition: {fileID: 0}
  failSafeDialogue: {fileID: 11400000}
  participants:
  - {fileID: 11400000, guid: 18983c6cf05ee4040bef40d61c29cc7d, type: 2}
  - {fileID: 11400000, guid: 3546db6422f82da45b4b98162056c5eb, type: 2}
  dialogueLines:
  - speaker: {fileID: 11400000, guid: 18983c6cf05ee4040bef40d61c29cc7d, type: 2}
    sentence: "\uD658\uC790\uAC00 \uC0DD\uAC01\uD55C \uAC70\uB791 \uB2EC\uB9AC, \uAC00\uC871\uB4E4\uC740
      \uD658\uC790\uB97C \uC81C\uB300\uB85C \uC0AC\uB791\uD558\uACE0 \uC788\uC5C8\uB124\uC694."
  - speaker: {fileID: 11400000, guid: 3546db6422f82da45b4b98162056c5eb, type: 2}
    sentence: "...\uADF8\uB7EC\uAC8C. \uBCF8\uC778 \uC785\uC73C\uB85C\uB3C4 \uB9D0\uD588\uC73C\uBA74\uC11C,
      \uC65C \uC78A\uC740 \uAC78\uAE4C."
  - speaker: {fileID: 11400000, guid: 18983c6cf05ee4040bef40d61c29cc7d, type: 2}
    sentence: "\uC678\uB85C\uC6CC\uC11C \uADF8\uB7AC\uB358 \uAC8C \uC544\uB2D0\uAE4C\uC694?
      \uC544\uB2C8\uB780 \uAC78 \uC54C\uBA74\uC11C\uB3C4, \uB2E4\uB978 \uC0AC\uB78C\uC744
      \uD0D3\uD558\uACE0 \uC2F6\uC744 \uB54C\uAC00 \uC788\uC796\uC544\uC694."
  - speaker: {fileID: 11400000, guid: 3546db6422f82da45b4b98162056c5eb, type: 2}
    sentence: "...\uBC30\uBD80\uB974\uAE34."
  - speaker: {fileID: 11400000, guid: 18983c6cf05ee4040bef40d61c29cc7d, type: 2}
    sentence: "\uB124?"
  - speaker: {fileID: 11400000, guid: 3546db6422f82da45b4b98162056c5eb, type: 2}
    sentence: "\uC544\uBB34 \uAC83\uB3C4 \uC544\uB0D0.  \uADF8\uBCF4\uB2E4 \uC0C1\uD669\uC740?"
  - speaker: {fileID: 11400000, guid: 18983c6cf05ee4040bef40d61c29cc7d, type: 2}
    sentence: "\uC74C.... \uC544\uC9C1 \uBCC0\uD654\uAC00 \uC5C6\uC5B4\uC694. \uC774\uAC8C
      \uD575\uC2EC \uAE30\uC5B5\uC774 \uC544\uB2C8\uC5C8\uB358 \uAC78\uAE4C\uC694?
      \uC774\uB807\uAC8C \uC911\uC694\uD55C \uAE30\uC5B5\uC778\uB370...."
  - speaker: {fileID: 11400000, guid: 3546db6422f82da45b4b98162056c5eb, type: 2}
    sentence: "\uC774\uAC8C \uB2E4\uAC00 \uC544\uB2C8\uB780 \uAC70\uACA0\uC9C0."
  - speaker: {fileID: 11400000, guid: 3546db6422f82da45b4b98162056c5eb, type: 2}
    sentence: "\uACC4\uC18D \uC6C0\uC9C1\uC774\uC790."
  - speaker: {fileID: 11400000, guid: 18983c6cf05ee4040bef40d61c29cc7d, type: 2}
    sentence: "\uB124. \uADF8\uB7F0\uB370 \uBB38\uC81C\uAC00...."
  - speaker: {fileID: 11400000, guid: 18983c6cf05ee4040bef40d61c29cc7d, type: 2}
    sentence: "\uB370\uBAA8\uB85C \uB9CC\uB4E0 \uBC84\uC804\uC774\uB77C\uC11C, \uC5EC\uAE30\uC11C
      \uAE30\uC5B5\uC774 \uB05D\uB098\uC694."
  - speaker: {fileID: 11400000, guid: 3546db6422f82da45b4b98162056c5eb, type: 2}
    sentence: "...\uADF8\uB807\uAC8C \uB9C9 \uB9D0\uD574\uB3C4 \uB3FC?"
  - speaker: {fileID: 11400000, guid: 18983c6cf05ee4040bef40d61c29cc7d, type: 2}
    sentence: "\uBB50 \uC5B4\uB54C\uC694. \uC120\uBC30\uB3C4 \uCC98\uC74C\uC5D0 E\uB2C8
      F\uB2C8 \uD588\uC73C\uBA74\uC11C."
  - speaker: {fileID: 11400000, guid: 3546db6422f82da45b4b98162056c5eb, type: 2}
    sentence: "...\uD560 \uB9D0\uC774 \uC5C6\uB124."
