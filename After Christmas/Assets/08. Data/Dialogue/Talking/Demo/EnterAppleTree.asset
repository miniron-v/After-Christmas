  dialogueLines:
  - speaker: {fileID: 11400000, guid: 22d606ec3d6e3044d9ac351a2f4f229b, type: 2}
    sentence: "\uB370\uBAA8\uC758 \uC8FC\uC778\uACF5 \uC568\uB9AC\uC2A4\uC785\uB2C8\uB2E4."
  - speaker: {fileID: 11400000, guid: 22d606ec3d6e3044d9ac351a2f4f229b, type: 2}
    sentence: "\uD3C9\uD654\uB85C\uC6B4 \uC5B4\uB290\uB0A0 \uC81C \uB208 \uC55E\uC5D0
      \uC815\uC7A5\uC744 \uC785\uC740 \uD1A0\uB07C\uAC00 \uC9C0\uB098\uAC00\uACE0"
  - speaker: {fileID: 11400000, guid: 22d606ec3d6e3044d9ac351a2f4f229b, type: 2}
    sentence: "\uC800\uB294 \uADF8\uAC78 \uB530\uB77C\uAC00\uB2E4 \uD1A0\uB07C\uAD74\uC5D0
      \uBE60\uC9C0\uAC8C \uB429\uB2C8\uB2E4."
  - speaker: {fileID: 11400000, guid: 900979b70a63165469ad60370ec7e6cd, type: 2}
    sentence: "\uC870\uAC74\uC744 \uB2EC\uC131\uD574\uC11C \uC9D1\uC73C\uB85C \uBB34\uC0AC\uD788
      \uB3CC\uB824\uBCF4\uB0B4\uC8FC\uC138\uC694."
