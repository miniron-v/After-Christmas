  m_Script: {fileID: 11500000, guid: 1c24672a27f90a24fb333e3077219294, type: 3}
  m_Name: 25. Brag Daughter
  m_EditorClassIdentifier: 
  dialogueID: 0
  prerequisiteCondition: {fileID: 0}
  failSafeDialogue: {fileID: 11400000}
  participants:
  - {fileID: 11400000, guid: 9ab2da8d8a102d544b3cd1b4f3e4b2c4, type: 2}
  dialogueLines:
  - speaker: {fileID: 11400000, guid: 987e42df4611eff46ac4e3e4b8260897, type: 2}
    sentence: "\uC9C4\uC9DC\uC694? \uC720\uB7FD\uC5D0 \uC720\uD559\uC774\uC694?"
  - speaker: {fileID: 11400000, guid: 9ab2da8d8a102d544b3cd1b4f3e4b2c4, type: 2}
    sentence: "\uADF8\uB798~ \uADF8\uB807\uB2E4\uB2C8\uAE4C. \uC9C0\uD604\uC774\uAC00
      \uC5BC\uB9C8\uB098 \uC798 \uCE58\uB358\uC9C0, \uAC00\uB974\uCE58\uB358 \uC120\uC0DD\uB2D8\uC774
      \uC598\uB294 \uAF2D \uC720\uD559\uAC00\uC57C \uD55C\uB2E4\uACE0 \uB09C\uB9AC\uC600\uC5B4,
      \uC644\uC804."
  - speaker: {fileID: 11400000, guid: 987e42df4611eff46ac4e3e4b8260897, type: 2}
    sentence: "\uD5D0.... \uADFC\uB370 \uC74C\uC545\uD558\uBA74 \uB3C8 \uB9CE\uC774
      \uAE68\uC9C0\uC9C0 \uC54A\uC544\uC694?"
  - speaker: {fileID: 11400000, guid: 9ab2da8d8a102d544b3cd1b4f3e4b2c4, type: 2}
    sentence: "\uB9CE\uC774 \uB4E4\uC9C0. \uADFC\uB370 \uADF8\uB807\uB2E4\uACE0 \uC560\uAC00
      \uD558\uACE0 \uC2F6\uC740 \uAC78 \uB9C9\uC744 \uC21C \uC5C6\uC796\uC544?"
  - speaker: {fileID: 11400000, guid: 9ab2da8d8a102d544b3cd1b4f3e4b2c4, type: 2}
    sentence: "\uB0B4\uAC00 \uC880 \uB35C \uC785\uACE0 \uB35C \uBA39\uC5B4\uB3C4
      \uC6B0\uB9AC \uC560 \uD558\uACE0 \uC2F6\uC740 \uAC74 \uD574\uC57C\uC9C0. \uADF8\uAC8C
      \uBD80\uBAA8 \uB9C8\uC74C\uC774\uC796\uC544."
