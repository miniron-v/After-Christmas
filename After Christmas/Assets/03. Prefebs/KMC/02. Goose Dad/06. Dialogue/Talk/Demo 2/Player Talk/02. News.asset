%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1c24672a27f90a24fb333e3077219294, type: 3}
  m_Name: 02. News
  m_EditorClassIdentifier: 
  dialogueID: 0
  prerequisiteCondition: {fileID: 0}
  failSafeDialogue: {fileID: 11400000}
  participants:
  - {fileID: 11400000, guid: 18983c6cf05ee4040bef40d61c29cc7d, type: 2}
  - {fileID: 11400000, guid: 3546db6422f82da45b4b98162056c5eb, type: 2}
  dialogueLines:
  - speaker: {fileID: 11400000, guid: 18983c6cf05ee4040bef40d61c29cc7d, type: 2}
    sentence: "...! \uBC30\uACBD\uC774 \uBC14\uAF08\uC5B4\uC694!"
  - speaker: {fileID: 11400000, guid: 3546db6422f82da45b4b98162056c5eb, type: 2}
    sentence: "\uAE30\uC5B5\uC744 \uAC74\uB4DC\uB824\uC11C, \uBB3C\uAC74\uACFC \uAD00\uB828\uB41C
      \uB2E4\uB978 \uAE30\uC5B5\uC774 \uB5A0\uC624\uB978 \uAC70\uC57C."
  - speaker: {fileID: 11400000, guid: 3546db6422f82da45b4b98162056c5eb, type: 2}
    sentence: "\uC774\uB807\uAC8C \uC774 \uC0AC\uB78C\uC758 \uAE30\uC5B5 \uC18D\uC744
      \uD0D0\uD5D8\uD558\uBA70, \uD575\uC2EC \uAE30\uC5B5\uACFC \uAC70\uAE30 \uB123\uC744
      \uBB3C\uAC74\uC744 \uCC3E\uB294 \uAC70\uC9C0."
  - speaker: {fileID: 11400000, guid: 18983c6cf05ee4040bef40d61c29cc7d, type: 2}
    sentence: "\uADF8\uB7FC, \uB2E4\uC2DC \uCF54\uD2B8\uB97C \uAC74\uB4DC\uB9AC\uBA74
      \uC5B4\uB5BB\uAC8C \uB418\uB098\uC694?"
  - speaker: {fileID: 11400000, guid: 3546db6422f82da45b4b98162056c5eb, type: 2}
    sentence: "\uBC29\uAE08\uAE4C\uC9C0 \uC788\uB358 \uAE30\uC5B5\uC73C\uB85C \uB3CC\uC544\uAC08
      \uAC70\uC57C."
  - speaker: {fileID: 11400000, guid: 3546db6422f82da45b4b98162056c5eb, type: 2}
    sentence: "\uC0AC\uC6A9\uD55C \uBB3C\uAC74\uC740 \uAE30\uACC4\uC5D0 \uC800\uC7A5\uB418\uB2C8\uAE4C,
      \uC5B8\uC81C\uB4E0\uC9C0 \uC778\uBCA4\uD1A0\uB9AC\uC5D0\uC11C \uAEBC\uB0BC
      \uC218 \uC788\uC5B4. \uC190\uC5D0 \uB4E4\uACE0 \uADE0\uC5F4\uC5D0 \uB123\uC73C\uBA74,
      \uB9DE\uB294 \uAE30\uC5B5\uC774\uBA74 \uADE0\uC5F4\uC774 \uBA54\uC6CC\uC9C0\uC9C0."
  - speaker: {fileID: 11400000, guid: 18983c6cf05ee4040bef40d61c29cc7d, type: 2}
    sentence: "\uC5B4... \uADF8\uB7FC \uC124\uB9C8, \uADE0\uC5F4\uC774 \uC788\uB294
      \uAE30\uC5B5\uAE4C\uC9C0 \uB2E4\uC2DC \uC640\uC57C... \uD558\uB294 \uAC70\uC8E0?
      \uC800 \uAE38 \uC798 \uBABB \uC678\uC6B0\uB294\uB370...?"
  - speaker: {fileID: 11400000, guid: 3546db6422f82da45b4b98162056c5eb, type: 2}
    sentence: "...\uD55C\uBC88 \uB2E4\uB140\uAC04 \uAE30\uC5B5\uC740 \uBC14\uB85C
      \uC62C \uC218 \uC788\uC5B4. \uAE30\uC5B5\uB3C4 \uAE30\uACC4\uC5D0 \uC800\uC7A5\uB418\uB2C8\uAE4C."
  - speaker: {fileID: 11400000, guid: 18983c6cf05ee4040bef40d61c29cc7d, type: 2}
    sentence: "\uC544\uD558...! \uB2E4\uD589\uC774\uB124\uC694. \uC0DD\uAC01\uBCF4\uB2E4
      \uCD5C\uCCA8\uB2E8\uC778\uB370\uC694?"
  - speaker: {fileID: 11400000, guid: 3546db6422f82da45b4b98162056c5eb, type: 2}
    sentence: "...\uC6B0\uB9AC \uC5F0\uAD6C\uC18C\uB294 \uC6D0\uB798 \uCD5C\uCCA8\uB2E8\uC774\uC57C.
      \uC774 \uAE30\uACC4\uB3C4 \uC9C1\uC811 \uB9CC\uB4E0 \uAC70\uACE0."
  - speaker: {fileID: 11400000, guid: 3546db6422f82da45b4b98162056c5eb, type: 2}
    sentence: "\uAE30\uACC4\uC5D0 \uBA54\uBAA8\uB3C4 \uD574\uB458 \uC218 \uC788\uC73C\uB2C8\uAE4C,
      \uADE0\uC5F4\uC5D0 \uBB50\uAC00 \uB4E4\uC5B4\uAC08\uC9C0 \uC0DD\uAC01\uD574\uC11C
      \uBBF8\uB9AC \uC801\uC5B4\uB450\uBA74 \uD310\uD560 \uAC70\uC57C."
